[global]
follow = mouse
frame_width = 1
frame_color = "#a9dc76"
separator_color= frame
background = "#24272E"
foreground = "#E1E3E4"
corner_radius = 5
progress_bar_corner_radius = 5
corners = top-left,bottom
progress_bar_corners = top-left,bottom-right
offset = (25, 25)
gap_size = 5
font = MesloLGS Nerd Font Mono, Noto Emoji 10
format = "<b>👉 %a</b>\n%s\n<i>%b</i>"

[urgency_low]
foreground = "#a9dc76"
frame_color = "#a9dc76"
default_icon = "~/.config/dunst/icons/bell-badge-low.svg"

[urgency_normal]
foreground = "#77d5f0"
frame_color = "#77d5f0"
default_icon = "~/.config/dunst/icons/bell-badge.svg"

[urgency_critical]
foreground = "#FF6188"
frame_color = "#FF6188"
default_icon = "~/.config/dunst/icons/alert-decagram.svg"
